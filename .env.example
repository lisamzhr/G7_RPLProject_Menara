# ==============================================================================
# RoofGarden Monorepo Environment Configuration (.env.example)
# Copy this file to .env in production or local development
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend & Security
APP_PORT=8000
SECRET_KEY=change-this-to-a-super-secret-random-jwt-key-min-32-chars
INTERNAL_TOKEN=internal-cron-service-token-secret-xyz123
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + pgvector)
# Local Docker or Supabase PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roofgarden
# Optional direct async URL if using asyncpg
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/roofgarden

# External APIs
# BMKG Weather API: https://api.bmkg.go.id/publik/prakiraan-cuaca?adm4={adm4_code}
BMKG_BASE_URL=https://api.bmkg.go.id/publik
OPEN_ELEVATION_BASE_URL=https://api.open-elevation.com/api/v1/lookup

# AI & LLM Provider (roofgarden_ai - Groq API Free Tier at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# APScheduler Background Job Intervals (in seconds / minutes)
JOB_EVALUATE_ZONES_INTERVAL_MINUTES=15
JOB_CHECK_NODE_HEALTH_INTERVAL_MINUTES=5
JOB_VERIFY_ACTIONS_INTERVAL_MINUTES=10

# Sensor Ingestion Constraints
NODE_OFFLINE_THRESHOLD_FACTOR=3
DEFAULT_NODE_SEND_INTERVAL_S=300

# Hardware / Node defaults (for simulator and firmware)
NODE_ID=esp32-node-01
NODE_API_KEY=dev-node-api-key-secret-12345
API_BASE_URL=http://localhost:8000/api/v1

# Frontend (Vite & Supabase Auth)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
